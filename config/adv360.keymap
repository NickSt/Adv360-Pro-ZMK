#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define KPAD 1
#define SYM  2
#define MOD  3
#define GAME 4

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &tog KPAD                                             &mo MOD    &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                 &none      &kp Y   &kp U   &kp I      &kp O     &kp P     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &mo SYM    &kp LCTRL  &kp LALT  &kp LGUI   &kp RCTRL  &mo SYM    &kp H   &kp J   &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                         &kp HOME  &kp PG_UP                        &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&mo SYM    &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC   &kp DEL    &kp END   &kp PG_DN  &kp ENTER  &kp SPACE          &kp UP  &kp DOWN   &kp LBKT  &kp RBKT  &mo SYM
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &trans                                               &mo MOD    &kp N6  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                &none      &kp Y   &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &mo SYM   &kp LCTRL  &kp LALT  &kp LGUI   &kp RCTRL  &mo SYM    &kp H   &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                        &kp HOME  &kp PG_UP                        &kp N   &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&mo SYM    &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp END   &kp PG_DN  &kp ENTER  &kp KP_N0          &kp UP      &kp DOWN      &kp KP_DOT     &kp RBKT         &mo SYM
            >;
        };

        fn {
            display-name = "Fn/Sym";
            bindings = <
&kp F1  &kp F2     &kp F3     &kp F4     &kp F5    &kp F6     &tog KPAD                                  &mo MOD  &kp F7     &kp F8         &kp F9           &kp F10        &kp F11         &kp F12
&trans  &kp GRAVE  &kp TILDE  &kp CARET  &kp AMPS  &kp PIPE   &trans                                     &trans   &kp DLLR   &kp LBKT       &kp RBKT         &kp LT         &kp GT          &trans
&trans  &kp EXCL   &kp MINUS  &kp EQUAL  &kp PLUS  &kp ASTRK  &trans     &trans  &trans  &trans  &trans  &trans   &kp PRCNT  &kp LPAR       &kp RPAR         &kp LBRC       &kp RBRC        &trans
&trans  &kp BSLH   &kp UNDER  &kp FSLH   &kp AT    &kp HASH                      &trans  &trans                   &trans     &macro_parens  &macro_brackets  &macro_braces  &macro_dquotes  &trans
&trans  &trans     &trans     &trans     &trans               &trans     &trans  &trans  &trans  &trans  &trans              &trans         &trans           &trans         &trans          &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                              &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                        &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &to GAME      &none        &none  &none  &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none  &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none  &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        game {
            display-name = "Game";
            bindings = <
&kp F1     &kp F2     &kp F3  &kp F4  &kp F5  &kp F6  &to BASE                                         &mo MOD  &kp F7  &kp F8  &kp F9  &kp F10    &kp F11    &kp F12
&kp GRAVE  &kp N1     &kp N2  &kp N3  &kp N4  &kp N5  &kp N6                                           &kp N7   &kp N8  &kp N9  &kp N0  &kp MINUS  &kp EQUAL  &trans
&kp ESC    &kp TAB    &kp Q   &kp W   &kp E   &kp R   &kp T      &kp G      &kp B      &trans  &trans  &trans   &trans  &trans  &trans  &trans     &trans     &trans
&kp M      &kp LSHFT  &kp A   &kp S   &kp D   &kp F                         &kp V      &trans                   &trans  &trans  &trans  &trans     &trans     &trans
&kp I      &kp LALT   &kp Z   &kp X   &kp C           &kp SPACE  &kp LSHFT  &kp LCTRL  &trans  &trans  &trans           &trans  &trans  &trans     &trans     &trans
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
